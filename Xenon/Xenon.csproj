<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>XenonEngine</PackageId>
    <Title>Xenon</Title>
    <Version></Version>
    <Company></Company>
    <Description>A simple, lightweight 2D/3D game engine, developed with Veldrid as a backend. </Description>
    <Copyright>2026 Newertech LLC and Xenon contributors</Copyright>
    <PackageProjectUrl>https://xenon3d.xyz</PackageProjectUrl>
    <PackageIcon></PackageIcon>
    <PackageTags>game-engine;graphics</PackageTags>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Marketing\xenon_poweredBy.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Marketing\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CS-Script" Version="4.14.11" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NeoVeldrid" Version="1.2.1" />
    <PackageReference Include="NeoVeldrid.ImageSharp" Version="1.2.1" />
    <PackageReference Include="NeoVeldrid.ImGui" Version="1.2.1" />
    <PackageReference Include="NeoVeldrid.SPIRV" Version="1.2.1" />
    <PackageReference Include="NeoVeldrid.StartupUtilities" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Marketing\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
